# 環境
.venv/
__pycache__/
*.pyc

# モデル・埋め込み（巨大、git 管理しない。フォルダだけ残す）
models/checkpoints/*
models/embeddings/*
!models/checkpoints/.keep
!models/embeddings/.keep

# 生成結果
outputs/*
!outputs/.keep

# お気に入り（生成画像なので同じく管理外）
favorites/*
!favorites/.keep
tools/quality_runs/

# Gradio / キャッシュ
.gradio/
flagged/
*.log
.hf_cache/
.thumb_cache/

# ダウンロード中の一時ファイル
*.part

# 個人設定・秘密情報（Civitai API キーなどを置く場合）
.env
config.local.json

# 実行時に学習した環境依存の記録（fp16 VAE が NaN を出したモデルの一覧）
.vae_fp32.json

# OS / エディタ
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# 拡張子違いのモデルも念のため除外
*.ckpt
*.pt
*.bin

# Claude Code の権限設定。ローカルの絶対パスやセッション ID を含み、
# 他の環境では意味を持たないため共有しない
.claude/settings.json
.claude/settings.local.json
